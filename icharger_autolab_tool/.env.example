# Windows Serial Communication & Bridge Environment Configuration
SERIAL_DEFAULT_PORT=COM3
SERIAL_DEFAULT_BAUD=115200
SERIAL_AUTO_RECONNECT=true
SERIAL_MAX_RECONNECT_RETRIES=15
SERIAL_INITIAL_DELAY_MS=1000
SERIAL_MAX_DELAY_MS=16000

# WebSocket Telemetry Server (For Node.js Serial Bridge)
WS_BRIDGE_HOST=127.0.0.1
WS_BRIDGE_PORT=8080
LOG_LEVEL=info

